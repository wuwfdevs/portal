# Copy to .env.local for local development. Never commit real values.
# This app has its OWN database. It never points at the Portal's Supabase projects.

# Local Postgres from `pnpm db:up` (docker compose). In hosted environments this is the
# site's own Supabase project's connection string (use the pooled one on Vercel).
DATABASE_URL=postgresql://wuwf:wuwf@127.0.0.1:5433/wuwf_site

# Used to encrypt JWT tokens. Generate with `openssl rand -hex 32`.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests.
PREVIEW_SECRET=YOUR_SECRET_HERE

# Staff sign-in from the Portal. Must equal the Portal's WEBSITE_IDENTITY_SECRET. At least 32 characters,
# used for this one channel only. Unset, the sign-in route answers "not set up on this server yet".
# `openssl rand -hex 32`
PORTAL_IDENTITY_SECRET=replace-with-the-same-value-as-the-portals-WEBSITE_IDENTITY_SECRET

# File storage. Leave empty locally: files stay on disk in public/media. In a hosted environment set all of these
# (Supabase Storage speaks the S3 protocol; the keys come from the project's Storage settings, never from the repository).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Audience sign-in (phase 7b): Supabase Auth on THIS app's own project (never the Portal's). Both are public by design.
# Sign-in emails are sent by Supabase through Resend's SMTP, set in the project's Auth settings (ROADMAP -> Phase 7b),
# so the site needs no email key and no service-role key. Unset, /account/sign-in says signing in is not set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Membership claim emails (phase 7c), sent by the site through Resend's HTTP API. Server only; set on Vercel, never here.
# A key with sending access only, and a sender on WUWF's verified domain. Unset, "Send the claim email" says email is not set up.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Audience listening (WUWF Listens): the site's server calls the Portal's signed listening API. Both are server-only; set on Vercel,
# never in a browser. Unset or wrong, the listening pages say "Listening is not set up on this server yet" and send nothing.
# The Portal's address: scheme and host only, no path or trailing slash (https; http only for localhost).
PORTAL_ORIGIN=
# The listening channel's own secret. Must equal the Portal's LISTENING_SIGNING_SECRET; at least 32 characters; used for this channel
# only. Use a different value per environment (the site's staging pairs with the Portal's Preview). `openssl rand -hex 32`
PORTAL_LISTENING_SECRET=

# Story embeddings (semantic search and "Related stories"). Both are server-only; set on Vercel, never in a browser. Unset, nothing is embedded,
# nothing is sent anywhere, and search stays keyword-only (the site works without them).
# OPENAI_API_KEY turns on INDEXING: a story's text (WUWF's own published stories only, never NPR or wire) is sent to OpenAI when it is saved
# and by scripts/embeddings/backfill.ts. It is a paid API: the owner authorises it (ROADMAP: Vector search and similar stories).
OPENAI_API_KEY=
# SEMANTIC_SEARCH=on additionally sends a visitor's SEARCH WORDS to OpenAI (to find stories by meaning). That is a disclosure about visitors, so
# it is its own switch, set only after the owner approves it and the privacy notice says so. Anything but "on" leaves search keyword-only.
SEMANTIC_SEARCH=
