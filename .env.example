# Copy to .env.local for local development. Never commit real values.
#
# Local dev: run `supabase start` and use the URL/anon key it prints
# (defaults below match the standard local Supabase CLI ports).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=tools-support@wuwf.org

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never commit. Only used by lib/supabase/admin.ts for auth.admin.* calls
# (inviting users). Get it from Project Settings > API in the Supabase
# dashboard for the project you're pointing at.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
