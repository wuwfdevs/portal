# Copy to .env.local for local development. Never commit real values.
#
# Local dev: run `supabase start` and use the URL/publishable key it prints
# (defaults below match the standard local Supabase CLI ports).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=tools-support@wuwf.org

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never commit. Used by lib/supabase/admin.ts for auth.admin.* calls
# (inviting users) and by the transcription webhook handler
# (src/app/api/transcription/webhook/route.ts), which has no signed-in user
# session to act as. Get it from Project Settings > API in the Supabase
# dashboard for the project you're pointing at.
SUPABASE_SECRET_KEY=replace-with-secret-key

# Transcription Workspace — ASR provider (AssemblyAI). Server-only.
ASSEMBLYAI_API_KEY=replace-with-assemblyai-api-key
# Shared secret AssemblyAI echoes back on its webhook callback so the route
# handler can verify the request actually came from AssemblyAI. Any long
# random string; generate with e.g. `openssl rand -hex 32`.
TRANSCRIPTION_WEBHOOK_SECRET=replace-with-a-long-random-string
