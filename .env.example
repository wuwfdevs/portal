# Copy to .env.local for local development. Never commit real values.
#
# Local dev: run `supabase start` and use the URL/publishable key it prints
# (defaults below match the standard local Supabase CLI ports).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=tools-support@wuwf.org

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never commit. Used by lib/supabase/admin.ts for auth.admin.* calls
# (inviting users) and by the transcription webhook handler
# (src/app/api/transcription/webhook/route.ts), which has no signed-in user
# session to act as. Get it from Project Settings > API in the Supabase
# dashboard for the project you're pointing at.
SUPABASE_SECRET_KEY=replace-with-secret-key

# Transcription Workspace — ASR provider (AssemblyAI). Server-only.
ASSEMBLYAI_API_KEY=replace-with-assemblyai-api-key
# Shared secret AssemblyAI echoes back on its webhook callback so the route
# handler can verify the request actually came from AssemblyAI. Any long
# random string; generate with e.g. `openssl rand -hex 32`.
TRANSCRIPTION_WEBHOOK_SECRET=replace-with-a-long-random-string

# Transcription Workspace — embeddings for semantic search (OpenAI
# text-embedding-3-small, 1536 dims to match the vector columns in
# 20260728120000_transcription_search.sql). Server-only.
#
# Optional. Without it the workspace still chunks and indexes every
# transcript, and search still works by keyword — only topic/semantic
# ranking is off. Set it and run "Rebuild search index" on a project (or
# just re-transcribe) to fill the embeddings in.
OPENAI_API_KEY=replace-with-openai-api-key

# Remote Interview — call layer (Daily). Server-only. Used by
# lib/remote-interview/daily.ts to create rooms, mint per-participant
# meeting tokens, and start/stop the raw-tracks cloud-backup recording (see
# docs/remote-interview-design.md §6 and the technical assessment's Part 2).
# Get it from the Daily dashboard for the account this deployment should use.
DAILY_API_KEY=replace-with-daily-api-key

# Optional. Configures raw-tracks recording to write to a customer-owned S3
# bucket rather than Daily's default recording storage — see the technical
# assessment's "open question for the prototype": whether Supabase Storage's
# S3-compatible endpoint works as this destination is still unverified, so
# these are unset by default and the cloud backup is simply skipped (with a
# clear warning in the studio, never a silent gap) until they're configured.
# Bucket must grant Daily's recorder write access — see Daily's docs on the
# recordings_bucket room property for the exact IAM shape.
DAILY_RECORDINGS_BUCKET_NAME=
DAILY_RECORDINGS_BUCKET_REGION=
DAILY_RECORDINGS_ASSUME_ROLE_ARN=

# In-portal agent (Phase D, docs/agent-capabilities-design.md §7). Server-only
# — used by src/lib/agent/chat.ts, which is the only thing that calls Claude
# directly in this repo. Without it, the chat widget's route returns a clear
# "not configured" error rather than crashing (see lib/agent/chat.ts). Get it
# from the Anthropic Console.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
