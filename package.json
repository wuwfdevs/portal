{
  "name": "wuwf-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:portal": "pnpm --filter wuwf-tools-portal build",
    "build:site": "pnpm --filter wuwf-site build",
    "db:check:portal": "pnpm --filter wuwf-tools-portal db:check",
    "dev:portal": "pnpm --filter wuwf-tools-portal dev",
    "dev:site": "pnpm --filter wuwf-site dev",
    "lint:portal": "pnpm --filter wuwf-tools-portal lint",
    "lint:site": "pnpm --filter wuwf-site lint",
    "portal": "pnpm --filter wuwf-tools-portal",
    "test:packages": "pnpm --filter \"./packages/*\" test",
    "test:portal": "pnpm --filter wuwf-tools-portal test",
    "test:pr-text": "node --test scripts/check-pr-text.test.mjs",
    "test:site": "pnpm --filter wuwf-site test:int",
    "typecheck:packages": "pnpm --filter \"./packages/*\" typecheck",
    "typecheck:portal": "pnpm --filter wuwf-tools-portal typecheck",
    "typecheck:site": "pnpm --filter wuwf-site typecheck"
  }
}
